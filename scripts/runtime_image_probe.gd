class_name RuntimeImageProbe
extends RefCounted
## Embedded encoded files exercise runtime buffer codecs in exported APKs too.
## Synthetic color quadrants are original project fixtures, CC0-1.0.
const Decoder = preload("res://scripts/image_decoder.gd")
const ENCODED := {
 "jpeg": "",
 "png": "iVBORw0KGgoAAAANSUhEUgAAACAAAAAYCAIAAAAUMWhjAAAAN0lEQVR4nGP8z0AaYCRRAxOJ5pMMRi0YtWDUguFgASMDA2mFy///jCSpH/pBNGrBqAWjFtDBAgAJsQUs5Y1ntQAAAABJRU5ErkJggg==",
 "webp": "UklGRjgAAABXRUJQVlA4TCwAAAAvH8AFAB8gEEjaH3qN+RcQFPk/2vwHXySAINtmkpOc5AUOENH/2DbVX4CqXw==",
 "bmp": "",
}

static func run() -> Dictionary:
 var result := {"all_ok": true, "formats": {}}
 for format: String in ENCODED:
  var decoder = Decoder.new()
  var bytes := Marshalls.base64_to_raw(ENCODED[format])
  var decoded: Image = decoder.decode_bytes(bytes)
  var entry := {"ok": false, "width": 0, "height": 0, "error": decoder.error_message}
  if decoded != null:
   entry.width = decoded.get_width()
   entry.height = decoded.get_height()
   var dimensions_ok := decoded.get_size() == Vector2i(32,24)
   var colors_ok := false
   if dimensions_ok:
    colors_ok = _close(decoded.get_pixel(4,4),Color.RED) and _close(decoded.get_pixel(27,4),Color.GREEN) and _close(decoded.get_pixel(4,19),Color.BLUE) and _close(decoded.get_pixel(27,19),Color.YELLOW)
   entry.ok = dimensions_ok and colors_ok
   if not entry.ok:
    entry.error = "Runtime codec returned unexpected dimensions or colors."
  result.formats[format] = entry
  result.all_ok = result.all_ok and entry.ok
 return result

static func _close(actual: Color, expected: Color) -> bool:
 return absf(actual.r-expected.r) < 0.12 and absf(actual.g-expected.g) < 0.12 and absf(actual.b-expected.b) < 0.12
